# Copy this file to ".env" and fill in your key.
OPENAI_API_KEY=sk-your-key-here

# --- Optional tuning -------------------------------------------------------
# Model used to write answers (must support image input).
CHAT_MODEL=gpt-4o
# Cheaper model used for query rewriting.
FAST_MODEL=gpt-4o-mini
# Model used to read images / scanned PDF pages.
VISION_MODEL=gpt-4o
EMBEDDING_MODEL=text-embedding-3-small

# Retrieval / chunking
TOP_K=8
CHUNK_SIZE=1200
CHUNK_OVERLAP=200

# Limits
MAX_UPLOAD_MB=50
MAX_VISION_PAGES=40
